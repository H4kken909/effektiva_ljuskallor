     10,
     6
    ],
    "stddev": [
     1.4142135623730951,
     0,
     1.4142135623730951
    ]
   },
   "note": "T03. Kärnan får bara stacken; maskerna i RX06 kombineras i wrappern (mask True, True, False)."
  },
