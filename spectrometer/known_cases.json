{
 "format": "gryb1-known-cases",
 "format_version": 1,
 "about": "Kända fall för beräkningskärnan, ur Räkneexempel i referensen (rev 7). null i en talarray betyder NaN. Talarrayer är float64 om input_dtype inte anges, masker är bool. Toleranser: relativ och absolut 1e-9; masker och NaN-positioner ska stämma exakt. Fall med level Senare gäller normalize, som är bortskuren veckan före Delrapport 2.",
 "tolerance": {
  "rtol": 1e-09,
  "atol": 1e-09
 },
 "cases": [
  {
   "id": "RX03",
   "function": "subtract_dark",
   "inputs": {
    "image": [
     [
      [
       7,
       7,
       7
      ]
     ]
    ],
    "dark": [
     [
      [
       10,
       10,
       10
      ]
     ]
    ]
   },
   "expected": {
    "out": [
     [
      [
       -3,
       -3,
       -3
      ]
     ]
    ]
   },
   "note": "T02. Shape (1,1,3). I uint8 skulle det bli 253."
  },
  {
   "id": "RX05",
   "function": "extract_spectrum",
   "inputs": {
    "roi": [
     [
      10,
      28,
      50
     ],
     [
      12,
      32,
      54
     ]
    ]
   },
   "expected": {
    "out": [
     11,
     30,
     52
    ]
   }
  },
  {
   "id": "RX06",
   "function": "average_spectra",
   "inputs": {
    "stack": [
     [
      2,
      10,
      5
     ],
     [
      4,
      10,
      7
     ]
    ]
   },
   "expected": {
    "mean": [
